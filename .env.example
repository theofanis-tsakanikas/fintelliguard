# .env.example — committed template. Copy to `.env` and fill NON-SECRET config only.
#
# SECRETS POLICY (do not violate):
#   - Application secrets (Databricks token, API keys) live in AWS Secrets Manager and
#     are fetched at runtime — they NEVER go in this file or in .env.
#   - AWS credentials live in ~/.aws/ via `aws configure` (or SSO) — NOT here.
#   - Never put a real secret value in .env or .env.example.
#
# `.env` is gitignored; `.env.example` is committed (template values only).

# ---- AWS -------------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_PROFILE=fintelliguard          # named profile in ~/.aws/config

# ---- Project ---------------------------------------------------------------
PROJECT=fintelliguard
ENVIRONMENT=dev

# ---- Observability (non-secret config) -------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=fintelliguard

# ---- Secrets — NOT set here; fetched from AWS Secrets Manager at runtime ----
# These are intentionally commented out, not fillable placeholders. Resolve them at
# runtime via GetSecretValue against the secret ids below (created by infra/aws).
#
# Databricks PAT    ->  secret id: fintelliguard/dev/databricks/token
# LangSmith API key ->  secret id: fintelliguard/dev/langsmith/api-key
