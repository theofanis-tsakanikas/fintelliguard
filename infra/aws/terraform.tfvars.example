# infra/aws — layer 1: VPC, KMS, S3, Secrets Manager, (optional) MSK.
#
# Nearly everything auto-derives from `project` + `environment`; override only what you
# must. NEVER put credentials here — this file's real counterpart is gitignored, but
# secrets belong in Secrets Manager or TF_VAR_ environment variables regardless.

aws_region  = "eu-central-1"
project     = "fintelliguard"
environment = "dev"

# --- MSK -----------------------------------------------------------------------------
# true = provision the real managed Kafka cluster, which is what the architecture actually
# describes. ~$0.11/hour for 2 x kafka.t3.small — cheap next to OpenSearch Serverless.
#
# The cost that matters here is TIME, not money: cluster creation takes 15-30 minutes and
# deletion another 10-20, on every apply/destroy cycle. `false` (local Kafka in docker)
# keeps those cycles fast while you are still debugging the deploy; `true` is the real
# thing, and avoids a second deploy later to swap it in.
enable_msk = true

# msk_broker_instance_type = "kafka.t3.small"
# msk_broker_ebs_gb        = 10

# --- Optional overrides ---------------------------------------------------------------
# raw_bucket_name = ""   # empty = auto-named from project/environment/account
# vpc_cidr        = "10.20.0.0/16"
# az_count        = 2

# Set only if you are attaching the Databricks PrivateLink endpoint service.
# databricks_privatelink_service_name = ""
