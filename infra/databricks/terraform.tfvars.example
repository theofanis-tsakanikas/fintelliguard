# infra/databricks — layer 2: workspace + Unity Catalog.
#
# ⚠️ The three credential variables are DELIBERATELY absent from this file. Supply them as
# environment variables so they never touch disk:
#
#   export TF_VAR_databricks_account_id="..."
#   export TF_VAR_databricks_client_id="..."
#   export TF_VAR_databricks_client_secret="..."
#
# In CI they come from the GitHub secrets of the same name. `*.tfvars` is gitignored, but
# a secret written to disk is still a secret on disk.

aws_region  = "eu-central-1"
project     = "fintelliguard"
environment = "dev"

# --- Optional overrides (empty = auto-derived) ----------------------------------------
# workspace_name         = ""   # default: <project>-<environment>
# root_bucket_name       = ""   # workspace DBFS root bucket
# metastore_name         = ""   # default: <project>-<region>
# metastore_storage_root = ""   # optional S3 URI for managed storage
# pricing_tier           = "PREMIUM"
